{
  "$schema": "https://opencode.ai/config.json",
    "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    }
  },
  "provider": {
    "cf-access": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Cloudflare Access Gateway",
      "options": {
        "baseURL": "https://gateway.ai.ontailwind.com/compat",
        "apiKey": "{env:CF_ACCESS_TOKEN}",
        "headers": {
          "cf-aig-skip-cache": "true",
          "cf-aig-collect-log-payload": "false",
          "cf-aig-request-timeout": "90000"
        }
      },
      "models": {
        "xai/grok-4.6": {
          "name": "Grok 4.6",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 500000,
            "output": 64000
          },
          "modalities": { "input": ["text", "image"] }
        },
        "anthropic/claude-opus-5": {
          "name": "Claude Opus 5",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 1000000, "output": 128000 },
          "modalities": { "input": ["text", "image"] }
        },
        "anthropic/claude-sonnet-5": {
          "name": "Claude Sonnet 5",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 1000000, "output": 128000 },
          "modalities": { "input": ["text", "image"] }
        },
        "anthropic/claude-haiku-4-5": {
          "name": "Claude Haiku 4.5",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 200000, "output": 64000 },
          "modalities": { "input": ["text", "image"] }
        },
        "workers-ai/@cf/zai-org/glm-5.3": {
          "name": "GLM 5.3",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 1048576, "output": 128000 },
          "modalities": { "input": ["text"] }
        },
        "workers-ai/@cf/zai-org/glm-5.3-flash": {
          "name": "GLM 5.3 Flash",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 1048576, "output": 128000 },
          "modalities": { "input": ["text", "image"] }
        }
      }
    },
    "cf-access-openai": {
      "npm": "@ai-sdk/openai",
      "name": "Cloudflare Access Gateway (OpenAI)",
      "options": {
        "baseURL": "https://gateway.ai.ontailwind.com/openai",
        "apiKey": "{env:CF_ACCESS_TOKEN}",
        "headers": {
          "cf-aig-skip-cache": "true",
          "cf-aig-collect-log-payload": "false",
          "cf-aig-request-timeout": "90000"
        }
      },
      "models": {
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 1050000, "output": 128000 },
          "modalities": { "input": ["text", "image"] }
        },
        "gpt-5.6-terra": {
          "name": "GPT-5.6 Terra",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 1050000, "output": 128000 },
          "modalities": { "input": ["text", "image"] }
        },
        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 1050000, "output": 128000 },
          "modalities": { "input": ["text", "image"] }
        }
      }
    },
    "cf-access-gemini": {
      "npm": "@ai-sdk/google",
      "name": "Cloudflare Access Gateway (Gemini native)",
      "options": {
        "baseURL": "https://gateway.ai.ontailwind.com/google-ai-studio/v1beta",
        "apiKey": "{env:CF_ACCESS_TOKEN}",
        "headers": {
          "Authorization": "Bearer {env:CF_ACCESS_TOKEN}",
          "cf-aig-skip-cache": "true",
          "cf-aig-collect-log-payload": "false",
          "cf-aig-request-timeout": "90000"
        }
      },
      "models": {
        "gemini-3.1-pro-preview": {
          "name": "Gemini 3.1 Pro Preview (native)",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 1048576, "output": 65536 },
          "modalities": { "input": ["text", "image"] }
        },
        "gemini-3.6-flash": {
          "name": "Gemini 3.6 Flash (native)",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 1048576, "output": 65536 },
          "modalities": { "input": ["text", "image"] }
        }
      }
    }
  }
}
